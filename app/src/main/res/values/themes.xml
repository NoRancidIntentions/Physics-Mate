<resources xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto"
           xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base application theme. -->
    <style name="Theme.PhysicsMate" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariant</item>
        <item name="colorOnPrimary">@color/white_color_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="android:colorSecondary">@color/grey_disable</item>
        <item name="colorSecondaryVariant">@color/grey_disable</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@drawable/empty</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/colorPrimary</item>

        <!-- Customize your theme here. -->
        <item name="android:buttonStyle">@style/custom_button</item>
        <item name="android:textViewStyle">@style/custom_textView</item>
        <item name="android:editTextStyle">@style/custom_numeric_edittext</item>
        <item name="android:checkboxStyle">@style/custom_checkBox</item>
        <item name="android:windowAnimationStyle">@style/CustomActivityAnimation</item>
    </style>


</resources>
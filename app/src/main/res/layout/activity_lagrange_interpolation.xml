<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:auto="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:weightSum="2"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/textView"
                    style="@style/custom_textView"
                    android:text="X values"
                    android:layout_weight="1"/>

            <TextView
                    android:id="@+id/textView17"
                    style="@style/custom_textView"
                    android:layout_weight="1"
                    android:text="Y values"
            />

        </LinearLayout>

        <LinearLayout
                android:id="@+id/LagrangeRowsLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                <EditText
                        style="@style/custom_numeric_edittext"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:id="@+id/Lagrangex1"
                        android:ems="4"
                        android:hint="x1"/>

                <EditText
                        style="@style/custom_numeric_edittext"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:ems="4"
                        android:id="@+id/Lagrangey1"
                        android:hint="y1"/>

            </LinearLayout>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                <EditText
                        style="@style/custom_numeric_edittext"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:id="@+id/Lagrangex2"
                        android:ems="4"
                        android:hint="x2"/>

                <EditText
                        style="@style/custom_numeric_edittext"
                        android:layout_marginBottom="0dp"
                        android:layout_weight="1"
                        android:id="@+id/Lagrangey2"
                        android:ems="4"
                        android:hint="y2"/>

            </LinearLayout>
        </LinearLayout>


        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LagrangeAddRowButton"
                style="@style/custom_button_enabled"
                android:layout_marginTop="40dp"
                android:text="Add Row"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/LagrangeCalcButton"
                style="@style/custom_button_enabled"
                android:layout_marginBottom="40dp"
                android:text="Get Polynomial"
        />

        <TextView
                android:id="@+id/LagrangeTvResult"
                style="@style/custom_textView"
                android:text="TextView"/>

        <io.github.kexanie.library.MathView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/LagrangeMathView"
                auto:engine="MathJax"
        />

    </LinearLayout>
</ScrollView>
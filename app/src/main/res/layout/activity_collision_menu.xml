<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatButton
        style = "@style/custom_button_enabled"
        android:id="@+id/btnDrop"
        android:text="Bouncing of a ball"
    />

    <androidx.appcompat.widget.AppCompatButton
        style = "@style/custom_button_enabled"
        android:id="@+id/btnLinearCollision"
        android:text="Linear collision of two balls"/>

    <androidx.appcompat.widget.AppCompatButton
        style = "@style/custom_button_enabled"
        android:id="@+id/btnObliqueCollision"
        android:text="Oblique collision of two balls"/>

</LinearLayout>
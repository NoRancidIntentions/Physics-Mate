<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/SV_2et_3tv_2btn_1graph_dynamic_calc"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

        <ImageView
                style="@style/custom_imageview_fixedratio"
                android:src="@drawable/losac"
                android:id="@+id/imageView_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
        />

        <TextView
                android:text="ERROR"
                android:id="@+id/tv1_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                style="@style/custom_textView"/>

        <EditText
                style="@style/custom_numeric_edittext"
                android:id="@+id/et1_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
        />

        <TextView
                android:text="ERROR"
                android:id="@+id/tv2_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/et2_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                style="@style/custom_numeric_edittext"/>


        <androidx.appcompat.widget.AppCompatButton
                android:text="error"
                android:id="@+id/btnCalc_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                style="@style/custom_button"/>

        <TextView
                android:text="ERROR"
                android:id="@+id/tvResults_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                android:textColor="@color/yellow_num_answer"
                style="@style/custom_textView"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="Copy to clipboard"
                android:id="@+id/btnCopy_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                style="@style/custom_button"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="Get Graph"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="45dp"
                android:id="@+id/btnGraph_activity_2et_2tv_1tvresult_1calcbtn_1copybtn_1graphbtn_dynamic_calc"
                style="@style/custom_button">

        </androidx.appcompat.widget.AppCompatButton>


    </LinearLayout>
</ScrollView>
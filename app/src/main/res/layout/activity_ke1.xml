<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">

    <LinearLayout
            style="@style/custom_linearLayout">

        <TextView
                style="@style/custom_textView"
                android:text="Please select the information which you have"
        />

        <TextView
                style="@style/custom_textView"
                android:text="Any three values are enough to find the other values"
                android:textSize="16sp"/>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
            <CheckBox
                    android:id="@+id/checkBox2"
                    style="@style/custom_checkBox"
                    android:text="acceleration &quot;a&quot;"/>

            <CheckBox
                    android:id="@+id/checkBox5"
                    style="@style/custom_checkBox"
                    android:text="initial velocity &quot;u&quot;"/>

            <CheckBox
                    android:id="@+id/checkBox3"
                    style="@style/custom_checkBox"
                    android:text="time &quot;t&quot;"/>

            <CheckBox
                    android:id="@+id/checkBox"
                    style="@style/custom_checkBox"
                    android:text="final velocity &quot;v&quot;"/>

            <CheckBox
                    android:id="@+id/checkBox4"
                    style="@style/custom_checkBox"
                    android:text="displacement &quot;s&quot;"/>

        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_enabled"
                android:id="@+id/button18"
                android:text="next"/>

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_enabled"
                android:id="@+id/button20"
                android:text="Clear all checkboxes"
        />

    </LinearLayout>
</ScrollView>
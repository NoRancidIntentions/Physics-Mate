<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activities.math.VarSolver">

    <androidx.appcompat.widget.AppCompatButton
            style="@style/custom_button_disabled"
            android:id="@+id/nextBtn"
            android:text="Next"
            android:enabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/numOfVar" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintEnd_toEndOf="parent"
            android:visibility="invisible" tools:visibility="invisible"/>
    <TextView
            android:id="@+id/textView"
            style="@style/custom_textView"
            android:text="Enter number of variables"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/numOfVar" app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.39" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintEnd_toEndOf="parent"
            android:visibility="invisible" tools:visibility="invisible"/>
    <EditText
            android:id="@+id/numOfVar"
            style="@style/custom_integer_edittext"
            android:inputType="number"
            android:hint="1"
            app:layout_constraintTop_toBottomOf="@+id/textView"
            app:layout_constraintBottom_toTopOf="@+id/nextBtn" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintEnd_toEndOf="parent"
            android:visibility="invisible" tools:visibility="invisible"/>

    <TextView
            android:id="@+id/textView2"
            style="@style/custom_textView"
            android:text="Enter number of equations"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/numOfEquation"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0.39"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintEnd_toEndOf="parent"
    />

    <EditText
            android:id="@+id/numOfEquation"
            style="@style/custom_integer_edittext"
            android:inputType="number"
            android:hint="1"
            app:layout_constraintTop_toBottomOf="@+id/textView2"
            app:layout_constraintBottom_toTopOf="@+id/nextBtn2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintEnd_toEndOf="parent"
    />

    <androidx.appcompat.widget.AppCompatButton
            style="@style/custom_button_disabled"
            android:id="@+id/nextBtn2"
            android:text="Next"
            android:enabled="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/numOfEquation" app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5" app:layout_constraintEnd_toEndOf="parent"
    />


</androidx.constraintlayout.widget.ConstraintLayout>
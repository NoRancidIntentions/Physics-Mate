<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:auto="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/derIntSymjaSV">

    <LinearLayout
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

        <TextView
                android:text="Enter the function to differentiate"
                android:layout_marginTop="45dp"
                style="@style/custom_textView"
                android:id="@+id/DerInttv1"
        />

        <EditText
                android:id="@+id/input_function"
                android:hint="(3x*cos(x))^(2*ln(x))"
                style="@style/custom_non_numeric_edittext"
                android:inputType="text"
                android:minHeight="48dp"/>

        <io.github.kexanie.library.MathView
                android:id="@+id/latexView1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                auto:engine="MathJax"
                android:textColor="@color/white_color_on_primary"
        />

        <TextView
                android:text="Enter the differentiating variable"
                style="@style/custom_textView"
                android:id="@+id/DerInttv2"

        />

        <EditText
                android:id="@+id/input_var"
                android:hint="x"
                style="@style/custom_non_numeric_edittext"
                android:inputType="text"
                android:digits="qwertyuioasdfghjklzxcvbnm"
                android:minHeight="48dp"/>

        <TextView
                android:text="Number of times to differentiate"
                style="@style/custom_textView"
                android:id="@+id/DerInttv3"

        />

        <EditText
                android:id="@+id/nth_der"
                android:hint="1"
                style="@style/custom_numeric_edittext"
                android:minHeight="48dp"/>


        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/calculate_derivative"
                android:text="Calculate Derivative"
                style="@style/custom_button"
        />

        <TextView
                android:id="@+id/result"
                android:text="Result"
                style="@style/custom_textView"
        />

        <io.github.kexanie.library.MathView
                android:id="@+id/latexView2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                auto:engine="MathJax"
                android:textColor="@color/white_color_on_primary"
        />

        <TextView
                android:id="@+id/simp_result"
                android:text="Simplified form"
                style="@style/custom_textView"
                android:layout_marginBottom="0dp"
        />

        <io.github.kexanie.library.MathView
                android:layout_marginBottom="45dp"
                android:layout_marginTop="0dp"
                android:id="@+id/latexView3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                auto:engine="MathJax"
                android:textColor="@color/white_color_on_primary"
        />

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button"
                android:text="Copy to clipboard"
                android:id="@+id/btnCopyDerInt"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGraphInfo"
                android:text="Get Graph"
                style="@style/custom_button"
        />

        <TextView
                style="@style/custom_textView"
                android:text="Enter minimum value of 'x'"
                android:id="@+id/derInttvMin"/>

        <EditText
                style="@style/custom_numeric_edittext"
                android:id="@+id/etXMinDerInt"
                android:hint="-10"/>

        <TextView
                style="@style/custom_textView"
                android:text="Enter maximum value of 'x'"
                android:id="@+id/derInttvMax"/>

        <EditText
                style="@style/custom_numeric_edittext"
                android:id="@+id/etXMaxDerInt"
                android:hint="10"/>

        <androidx.appcompat.widget.AppCompatButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/custom_button"
                android:text="Next"
                android:id="@+id/btnGraph"/>

    </LinearLayout>
</ScrollView>
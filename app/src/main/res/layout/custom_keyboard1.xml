<?xml version="1.0" encoding="utf-8"?>

<HorizontalScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center"
        android:gravity="center"
        android:background="@color/darker_grey">

    <GridLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:columnCount="10"
            android:rowCount="4"
            android:layout_gravity="bottom"
    >

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonElectronCharge"
                style="@style/custom_button_enabled_keyboard"
                android:text="e-"
                android:layout_row="0"
                android:layout_column="9"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonElectronMass"
                style="@style/custom_button_enabled_keyboard"
                android:text="m_e"
                android:layout_row="1"
                android:layout_column="9"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonProtonMass"
                style="@style/custom_button_enabled_keyboard"
                android:text="m_p"
                android:layout_row="2"
                android:layout_column="9"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonNeutronMass"
                style="@style/custom_button_enabled_keyboard"
                android:text="m_n"
                android:layout_row="3"
                android:layout_column="9"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonLightSpeed"
                style="@style/custom_button_enabled_keyboard"
                android:text="c"
                android:layout_row="3"
                android:layout_column="7"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button1"
                style="@style/custom_button_enabled_keyboard"
                android:text="1"
                android:layout_row="0"
                android:layout_column="0"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button2"
                style="@style/custom_button_enabled_keyboard"
                android:text="2"
                android:layout_row="0"
                android:layout_column="1"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button3"
                style="@style/custom_button_enabled_keyboard"
                android:text="3"
                android:layout_row="0"
                android:layout_column="2"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button4"
                style="@style/custom_button_enabled_keyboard"
                android:text="4"
                android:layout_row="1"
                android:layout_column="0"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button5"
                style="@style/custom_button_enabled_keyboard"
                android:text="5"
                android:layout_row="1"
                android:layout_column="1"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button6"
                style="@style/custom_button_enabled_keyboard"
                android:text="6"
                android:layout_row="1"
                android:layout_column="2"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button7"
                style="@style/custom_button_enabled_keyboard"
                android:text="7"
                android:layout_row="2"
                android:layout_column="0"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button8"
                style="@style/custom_button_enabled_keyboard"
                android:text="8"
                android:layout_row="2"
                android:layout_column="1"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button9"
                style="@style/custom_button_enabled_keyboard"
                android:text="9"
                android:layout_row="2"
                android:layout_column="2"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button0"
                style="@style/custom_button_enabled_keyboard"
                android:text="0"
                android:layout_row="3"
                android:layout_column="1"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonBackspace"
                style="@style/custom_button_enabled_keyboard"
                android:text="⌫"
                android:layout_row="3"
                android:layout_column="2"/>

        <!-- create a button which will be used to switch between the custom keyboard and the symbols keyboard which contains e, pi, sin, cos, arcsin, etc. -->

        <!-- add +, -, / and * buttons -->
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonPlus"
                style="@style/custom_button_enabled_keyboard"
                android:fontFamily="sans-serif-black"
                android:text="+"
                android:layout_row="0"
                android:layout_column="3"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonMinus"
                style="@style/custom_button_enabled_keyboard"
                android:text="-"
                android:layout_row="1"
                android:layout_column="3"
                android:fontFamily="sans-serif-black"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonMultiply"
                style="@style/custom_button_enabled_keyboard"
                android:fontFamily="sans-serif-black"
                android:text="*"
                android:layout_row="2"
                android:layout_column="3"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonDivide"
                style="@style/custom_button_enabled_keyboard"
                android:text="/"
                android:fontFamily="sans-serif-black"
                android:layout_row="3"
                android:layout_column="3"/>

        <!--   ################################################ -->

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_sin"
                style="@style/custom_button_enabled_keyboard"
                android:text="sin"
                android:fontFamily="sans-serif-black"
                android:layout_row="0"
                android:layout_column="4"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_cos"
                style="@style/custom_button_enabled_keyboard"
                android:text="cos"
                android:fontFamily="sans-serif-black"
                android:layout_row="0"
                android:layout_column="5"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_tan"
                style="@style/custom_button_enabled_keyboard"
                android:text="tan"
                android:fontFamily="sans-serif-black"
                android:layout_row="0"
                android:layout_column="6"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_arcsin"
                style="@style/custom_button_enabled_keyboard"
                android:text="sin⁻¹"
                android:fontFamily="sans-serif-black"
                android:layout_row="1"
                android:layout_column="4"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_arccos"
                style="@style/custom_button_enabled_keyboard"
                android:text="cos⁻¹"
                android:fontFamily="sans-serif-black"
                android:layout_row="1"
                android:layout_column="5"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_arctan"
                style="@style/custom_button_enabled_keyboard"
                android:text="tan⁻¹"
                android:fontFamily="sans-serif-black"
                android:layout_row="1"
                android:layout_column="6"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_factorial"
                style="@style/custom_button_enabled_keyboard"
                android:text="n!"
                android:fontFamily="sans-serif-black"
                android:layout_row="3"
                android:layout_column="6"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonLn"
                style="@style/custom_button_enabled_keyboard"
                android:text="ln"
                android:fontFamily="sans-serif-black"
                android:layout_row="2"
                android:layout_column="6"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonLog10"
                style="@style/custom_button_enabled_keyboard"
                android:text="log10"
                android:fontFamily="sans-serif-black"
                android:layout_row="2"
                android:layout_column="7"/>


        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_left_bracket"
                style="@style/custom_button_enabled_keyboard"
                android:text="("
                android:fontFamily="sans-serif-black"
                android:layout_row="2"
                android:layout_column="4"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_right_bracket"
                style="@style/custom_button_enabled_keyboard"
                android:text=")"
                android:fontFamily="sans-serif-black"
                android:layout_row="2"
                android:layout_column="5"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_pi"
                style="@style/custom_button_enabled_keyboard"
                android:text="π"
                android:fontFamily="sans-serif-black"
                android:layout_row="0"
                android:layout_column="7"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonPlank"
                style="@style/custom_button_enabled_keyboard"
                android:text="h"
                android:fontFamily="sans-serif-black"
                android:layout_row="1"
                android:layout_column="8"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonG"
                style="@style/custom_button_enabled_keyboard"
                android:text="G"
                android:fontFamily="sans-serif-black"
                android:layout_row="2"
                android:layout_column="8"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonPermittivity"
                style="@style/custom_button_enabled_keyboard"
                android:text="ε"
                android:fontFamily="sans-serif-black"
                android:layout_row="0"
                android:layout_column="8"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonPermeability"
                style="@style/custom_button_enabled_keyboard"
                android:text="μ"
                android:fontFamily="sans-serif-black"
                android:layout_row="3"
                android:layout_column="8"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_e"
                style="@style/custom_button_enabled_keyboard"
                android:text="e"
                android:fontFamily="sans-serif-black"
                android:layout_row="1"
                android:layout_column="7"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/buttonDecimal"
                style="@style/custom_button_enabled_keyboard"
                android:padding="0dp"
                android:layout_marginTop="-8dp"
                android:text=".\n           ,"
                android:fontFamily="sans-serif-black"
                android:layout_row="3"
                android:layout_column="0"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="^"
                style = "@style/custom_button_enabled_keyboard"
                android:layout_row="3" android:layout_column="4"
                android:id="@+id/button_power"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="|n|"
                style = "@style/custom_button_enabled_keyboard"
                android:layout_row="3" android:layout_column="5"
                android:id="@+id/button_modulus"/>


    </GridLayout>
</HorizontalScrollView>
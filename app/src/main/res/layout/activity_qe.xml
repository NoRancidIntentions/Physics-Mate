<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/SV_QE"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            tools:context=".activities.math.QE">

        <TextView
                android:id="@+id/textView22"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Please enter the coefficients"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <HorizontalScrollView
                android:id="@+id/horizontalScrollView"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@color/app_bg"
                app:layout_constraintBottom_toTopOf="@+id/button9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView22">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/app_bg">

                <EditText
                        android:singleLine="true"

                        android:id="@+id/editTextNumberDecimal19"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="3"
                        android:gravity="bottom|center_horizontal"
                        android:hint="a"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="40sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/editTextNumberDecimal20"
                        app:layout_constraintHorizontal_chainStyle="spread_inside"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/editTextNumberDecimal20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="3"
                        android:gravity="bottom|center_horizontal"
                        android:hint="b"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="40sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/editTextNumberDecimal21"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/editTextNumberDecimal19"
                        app:layout_constraintTop_toTopOf="parent"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/editTextNumberDecimal21"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ems="3"
                        android:gravity="bottom|center_horizontal"
                        android:hint="c"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="40sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/editTextNumberDecimal20"
                        app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                        android:id="@+id/imageView9"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_marginBottom="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/editTextNumberDecimal19"
                        app:layout_constraintStart_toEndOf="@+id/editTextNumberDecimal19"
                        app:srcCompat="@drawable/qex2"/>

                <ImageView
                        android:id="@+id/imageView12"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginBottom="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/editTextNumberDecimal20"
                        app:layout_constraintStart_toEndOf="@+id/editTextNumberDecimal20"
                        app:srcCompat="@drawable/qex"/>

                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="30dp"
                        android:layout_marginBottom="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/imageView9"
                        app:layout_constraintEnd_toStartOf="@+id/editTextNumberDecimal20"
                        app:layout_constraintStart_toEndOf="@+id/imageView9"
                        app:srcCompat="@drawable/qeplusy"/>

                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginBottom="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/imageView12"
                        app:layout_constraintEnd_toStartOf="@+id/editTextNumberDecimal21"
                        app:layout_constraintStart_toEndOf="@+id/imageView12"
                        app:srcCompat="@drawable/qeplus"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button9"
                style="@style/custom_button_enabled"
                app:layout_constraintBottom_toTopOf="@+id/textView23"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView"/>

        <TextView
                android:id="@+id/textView23"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_semi_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="25sp"
                app:layout_constraintBottom_toTopOf="@+id/textView25"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/button9"/>

        <TextView
                android:id="@+id/textView25"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_semi_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="25sp"
                app:layout_constraintBottom_toTopOf="@+id/textView26"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView23"/>

        <TextView
                android:id="@+id/textView26"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_semi_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="25sp"
                app:layout_constraintBottom_toTopOf="@+id/btnQE2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView25"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQE2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="Get area under the curve"
                android:textColor="@drawable/dynamic_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/textView27"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView26"/>

        <TextView
                android:id="@+id/textView27"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Enter minimum value of 'x'"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/editTextNumberDecimal16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnQE2"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/editTextNumberDecimal16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center_vertical"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:inputType="phone"
                android:digits="+-0123*/456789." android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="bottom|center_horizontal"
                android:hint="(can enter negative values)"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="25sp"
                app:layout_constraintBottom_toTopOf="@+id/textView24"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView27"/>

        <TextView
                android:id="@+id/textView24"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Enter maximum value of 'x'"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/editTextNumberDecimal17"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextNumberDecimal16"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/editTextNumberDecimal17"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center_vertical"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:inputType="phone"
                android:digits="+-0123*/456789." android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="bottom|center_horizontal"
                android:hint="(can enter negative values)"
                android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="25sp"
                app:layout_constraintBottom_toTopOf="@+id/btnQEArea"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView24"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button11"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="get graph"
                android:textColor="@drawable/dynamic_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvQEArea"/>

        <TextView
                android:id="@+id/tvQEArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_semi_bold"
                android:gravity="center"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="25sp"
                app:layout_constraintBottom_toTopOf="@+id/button11"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnQEArea"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnQEArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:text="Calculate area under the curve"
                android:textColor="@drawable/dynamic_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/tvQEArea"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextNumberDecimal17"/>


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            android:orientation="vertical">

        <ImageView
                android:id="@+id/imageView"
                android:layout_width="350dp"
                android:layout_height="264dp"
                android:background="@drawable/nlogpic"
                android:scaleType="fitCenter"
                android:layout_marginTop="45dp"
                android:layout_marginBottom="15dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:foregroundGravity="center"
                android:layout_gravity="center"/>

        <TextView
                android:id="@+id/textView29"
                android:text="Please select the required formula"
                style="@style/custom_textView"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="Newton's law of gravitation"
                android:id="@+id/button24"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Potential"
                android:id="@+id/button31"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Potential Energy"
                android:id="@+id/button36"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Accleration"
                android:id="@+id/button38"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Binding Energy"
                android:id="@+id/button32"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Escape Velocity"
                android:id="@+id/button34"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Orbital Velocity"
                android:id="@+id/button37"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Kepler's Third Law"
                android:id="@+id/button26"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Time Dilation"
                android:id="@+id/button33"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Lensing"
                android:id="@+id/button35"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Torque"
                android:id="@+id/button40"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Schwarzschild Radius"
                android:id="@+id/button39"
                style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Roche Limit"
                android:id="@+id/btnRoche" style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Tidal Force"
                android:id="@+id/btnTidalForce" style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Wave Energy"
                android:id="@+id/btnGravWaveEnergy" style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Wave Frequency"
                android:id="@+id/btnGravWaveFrequency" style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Wave Luminosity"
                android:id="@+id/btnGravWaveLuminosity" style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Gravitational Redshift"
                android:id="@+id/btnGravRedShift" style="@style/custom_button"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Jean's Mass"
                android:layout_marginBottom="45dp"
                android:id="@+id/btnJeansMass" style="@style/custom_button"
        />

    </LinearLayout>

</ScrollView>

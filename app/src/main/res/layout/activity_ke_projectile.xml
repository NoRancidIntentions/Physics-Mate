<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            style="@style/custom_linearLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            tools:context=".activities.physics.Kinematics$KE2">

        <ImageView
                android:src="@drawable/ke2"
                style="@style/custom_imageview_fixedratio"
                android:layout_marginTop="40dp"/>

        <TextView
                android:text="Enter Coordinates (X, Y)"
                android:id="@+id/textView42"
                style="@style/custom_textView"
        />

        <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp">
            <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                <EditText
                        android:id="@+id/etX"
                        style="@style/custom_integer_edittext"
                        android:hint="X - coordinate"
                        android:layout_marginBottom="0dp"/>

                <EditText
                        android:id="@+id/etY"
                        android:hint="Y - coordinate"
                        style="@style/custom_integer_edittext"
                        android:layout_marginBottom="0dp"
                />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
                android:text="Enter Magnitude of velocity in SI unit"
                android:id="@+id/textView43"
                style="@style/custom_textView"
        />

        <EditText
                android:id="@+id/etVelocityMagnitude"
                style="@style/custom_integer_edittext"
                android:hint="m/s"
        />

        <TextView
                android:text="Enter Angle A \n (Inclined plane angle)"
                android:id="@+id/textView44"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/etInclinedPlaneAngle"
                style="@style/custom_integer_edittext"
                android:hint="Degrees"/>

        <TextView
                android:text="Enter Enter angle b \n (Angle of Projection)"
                android:id="@+id/textView45"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/etProjectionAngle"
                style="@style/custom_integer_edittext"
                android:hint="Degrees"/>

        <TextView
                android:text="Enter gravity in SI unit"
                android:id="@+id/textView46"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/etGravity"
                android:hint="m/s²"
                style="@style/custom_integer_edittext"/>

        <CheckBox
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Include air resistance"
                style = "@style/custom_checkBox"
                android:id="@+id/cbAirResistance" />


        <TextView
                android:text="Mass of object in SI unit"
                android:id="@+id/textView48"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/etMass"
                style="@style/custom_integer_edittext"
                android:hint="2"/>

        <!--Also ask for cross section area, density of air -->

        <TextView
                android:text="Enter cross section area of object in SI unit"
                android:id="@+id/textView49"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/etArea"
                style="@style/custom_integer_edittext"
                android:hint="0.05"/>

        <TextView
                android:text="Enter density of air in SI unit"
                android:id="@+id/textView50"
                style="@style/custom_textView"/>

        <EditText
                android:id="@+id/etDensity"
                style="@style/custom_integer_edittext"
                android:hint="1.2"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="find the remaining values"
                android:id="@+id/button15"
                style="@style/custom_button_enabled"/>

        <TextView
                android:text="TextView"
                android:id="@+id/tvResult"
                style="@style/custom_textView"/>

        <com.github.mikephil.charting.charts.LineChart
                android:layout_width="match_parent"
                android:layout_height="600dp"
                android:id="@+id/lineChart2"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
>
    <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent" app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/SV_ke_projectile">

        <LinearLayout
                style="@style/custom_linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/app_bg"
                tools:context=".activities.physics.Kinematics$KE2">

            <ImageView
                    android:src="@drawable/ke2"
                    style="@style/custom_imageview_fixedratio"
                    android:layout_marginTop="40dp"/>

            <TextView
                    android:text="Enter Coordinates (Xp, Yp) for point of projection"
                    style="@style/custom_textView"
            />

            <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp">
                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                    <EditText
                            android:id="@+id/etXp"
                            style="@style/custom_edittext"
                            android:hint="X - coordinate"
                            android:layout_marginBottom="0dp"/>

                    <EditText
                            android:id="@+id/etYp"
                            android:hint="Y - coordinate"
                            style="@style/custom_edittext"
                            android:layout_marginBottom="0dp"
                    />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                    android:text="Enter Coordinates (Xi, Yi) for starting point of inclined plane"
                    style="@style/custom_textView"
            />

            <TextView
                    android:text="Note that the ground level is at Y = 0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/blue_text_answer"/>

            <HorizontalScrollView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp">
                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                    <EditText
                            android:id="@+id/etXi"
                            style="@style/custom_edittext"
                            android:hint="X - coordinate"
                            android:layout_marginBottom="0dp"/>

                    <EditText
                            android:id="@+id/etYi"
                            android:hint="Y - coordinate"
                            style="@style/custom_edittext"
                            android:layout_marginBottom="0dp"
                    />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                    android:text="Enter Magnitude of velocity in SI unit"
                    style="@style/custom_textView"
            />

            <EditText
                    android:id="@+id/etVelocityMagnitude"
                    style="@style/custom_edittext"
                    android:hint="m/s"
            />

            <TextView
                    android:text="Enter Angle A \n (Inclined plane angle)"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etInclinedPlaneAngle"
                    style="@style/custom_edittext"
                    android:hint="Degrees"/>

            <TextView
                    android:text="Enter Enter angle b \n (Angle of Projection wrt ground (horizontal))"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etProjectionAngle"
                    style="@style/custom_edittext"
                    android:hint="Degrees"/>

            <TextView
                    android:text="Enter gravity in SI unit"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etGravity"
                    android:hint="m/s²"
                    style="@style/custom_edittext"/>

            <CheckBox
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Include air resistance"
                    style="@style/custom_checkBox"
                    android:id="@+id/cbAirResistance"/>


            <TextView
                    android:text="Mass of object in SI unit"
                    android:id="@+id/textView48"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etMass"
                    style="@style/custom_edittext"
                    android:hint="2"/>

            <!--Also ask for cross section area, density of air -->

            <TextView
                    android:text="Enter cross section area of object in SI unit"
                    android:id="@+id/textView49"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etArea"
                    style="@style/custom_edittext"
                    android:hint="0.05"/>

            <TextView
                    android:text="Enter density of air in SI unit"
                    android:id="@+id/textView50"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etDensity"
                    style="@style/custom_edittext"
                    android:hint="1.2"/>

            <TextView
                    android:text="Enter drag coefficient c"
                    android:id="@+id/textView51"
                    style="@style/custom_textView"/>

            <EditText
                    android:id="@+id/etDragCoefficient"
                    style="@style/custom_edittext"
                    android:hint="0.47"/>

            <androidx.appcompat.widget.AppCompatButton
                    android:text="find the remaining values"
                    android:id="@+id/btnCalc"
                    style="@style/custom_button_enabled"/>

            <TextView
                    android:text="See how we calculate air resistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/blue_text_answer"
                    android:clickable="true"
                    android:id="@+id/tvAirResistanceInfo"
            />

            <TextView
                    android:text="TextView"
                    android:id="@+id/tvResult"
                    style="@style/custom_textView"/>

            <androidx.appcompat.widget.AppCompatButton
                    android:text="Get Graphs"
                    android:id="@+id/btnGetGraphs"
                    style="@style/custom_button_enabled"/>

            <com.github.mikephil.charting.charts.LineChart
                    android:layout_width="match_parent"
                    android:layout_height="600dp"
                    android:id="@+id/lineChart2"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="30dp"/>

        </LinearLayout>
    </ScrollView>

    <com.example.physicsmate.ui.main.custom_keyboard1_initializer
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/custom_keyboard1_initializer_ke_projectile"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
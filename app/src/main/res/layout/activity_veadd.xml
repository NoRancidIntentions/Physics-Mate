<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/SV_VE"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg"
            tools:context=".activities.math.VEAdd">

        <ImageView
                android:id="@+id/imageView10"
                android:layout_width="337dp"
                android:layout_height="247dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                app:layout_constraintBottom_toTopOf="@+id/textView28"
                app:layout_constraintDimensionRatio="1221:759"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/vector_addition"/>

        <TextView
                android:id="@+id/textView28"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Please enter values for vector A"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView10"/>

        <HorizontalScrollView
                android:id="@+id/horizontalScrollView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:foregroundGravity="center_vertical|center_horizontal"
                app:layout_constraintBottom_toTopOf="@+id/textView33"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView28"
                tools:ignore="SpeakableTextPresentCheck">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etAi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="i"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="i  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etAj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="j"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="j  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etAk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="k"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="k  "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
                android:id="@+id/textView33"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Please enter values for vector B"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollViewSub"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView2"/>

        <HorizontalScrollView
                android:id="@+id/horizontalScrollViewSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:foregroundGravity="center_vertical|center_horizontal"
                app:layout_constraintBottom_toTopOf="@+id/btnVEAdd"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView33"
                tools:ignore="SpeakableTextPresentCheck">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etBi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="i"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:textAllCaps="false"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="i  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etBj"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="j"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="j  + "
                        android:textAllCaps="false"
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etBk"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:inputType="phone"
                        android:digits="+-0123*/456789." android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="k"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="k  "
                        android:textAllCaps="false"
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVEAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="Get Information"
                android:textColor="@drawable/dynamic_text"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/tvVEAddResults"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollViewSub"/>

        <TextView
                android:id="@+id/tvVEAddResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="50dp"
                android:fontFamily="@font/sans_semi_bold"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnVEAdd"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/SV_NLOG2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">


    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            tools:context=".activities.Gravitation$NLOG$NLOG2">

        <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center"
                android:text="Mass of first the object"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/etNLOG2m"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/etNLOG2m"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal|center_vertical"
                android:hint="Enter mass in kg"
                android:inputType="phone"
                android:digits="+-0*/456789." android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/textView7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView6"/>

        <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center"
                android:text="Force between the objects"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/etNLOG2n"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etNLOG2m"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/etNLOG2n"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:hint="Enter force in N"
                android:inputType="phone"
                android:digits="+-0*/456789." android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/textView8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView7"/>

        <TextView
                android:id="@+id/textView8"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center"
                android:text="Distance between the centre of the objects"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/etNLOG2r"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etNLOG2n"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG2calculate"
                android:layout_width="371dp"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="calculate mass of second object"
                android:textColor="@drawable/dynamic_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/tvNLOG2result"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etNLOG2r"/>

        <TextView
                android:id="@+id/tvNLOG2result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_semi_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/btnNLOG2copy"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnNLOG2calculate"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG2copy"
                android:layout_width="381dp"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="50dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="copy to clipboard"
                android:textColor="@drawable/dynamic_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvNLOG2result"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/etNLOG2r"
                android:layout_width="wrap_content"

                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal|center_vertical"
                android:hint="Enter distance in m"
                android:inputType="phone"
                android:digits="+-0*/456789." android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/btnNLOG2calculate"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView8"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
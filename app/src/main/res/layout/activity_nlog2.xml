<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/SV_NLOG2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">


    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            style = "@style/custom_linearLayout"
            android:orientation="vertical">

        <TextView
                android:id="@+id/textView6"
                android:text="Mass of first the object"
                style="@style/custom_textView"/>

        <EditText
                style = "@style/custom_edittext"
                android:hint="Enter mass in kg"
                android:id="@+id/etNLOG2m"
        />

        <TextView
                android:id="@+id/textView7"
                android:text="Force between the objects"
                style="@style/custom_textView"/>

        <EditText
                style = "@style/custom_edittext"
                android:hint="Enter force in N"
                android:id="@+id/etNLOG2n"
        />

        <TextView
                android:id="@+id/textView8"
                android:text="Distance between the centre of the objects"
                style="@style/custom_textView"/>

        <EditText
                style = "@style/custom_edittext"
                android:id="@+id/etNLOG2r"
                android:hint="Enter distance in m"

        />
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG2calculate"
                style = "@style/custom_button_enabled"
                android:text="calculate mass of second object"
                android:textColor="@drawable/dynamic_text"
        />

        <TextView
                android:id="@+id/tvNLOG2result"
                android:text="TextView"
                style="@style/custom_textView"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG2copy"
                style="@style/custom_button_enabled"
                android:text="copy to clipboard"
        />

    </LinearLayout>

</ScrollView>
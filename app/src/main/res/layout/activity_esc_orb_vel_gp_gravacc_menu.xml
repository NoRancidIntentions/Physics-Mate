<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:context=".activities.Gravitation$EscVelMenu"
            android:orientation="vertical">

        <ImageView
                android:src="@drawable/escvelpng"
                android:layout_width="match_parent"
                android:scaleType="fitCenter"
                android:layout_height="150dp"
                android:id="@+id/imageView26"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:layout_marginStart="50dp"
                android:layout_marginEnd="50dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="15dp"/>

        <TextView
                style="@style/custom_textView"
                android:text="Please select the unknown variable"/>

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_enabled"
                android:text="Escape velocity v"
                android:id="@+id/button41"/>

        <androidx.appcompat.widget.AppCompatButton
                android:text="Mass M"
                style="@style/custom_button_enabled"
                android:id="@+id/button42"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:text="Radius R"
                style="@style/custom_button_enabled"
                android:id="@+id/button43"
                android:layout_marginBottom="45dp"
        />
    </LinearLayout>
</ScrollView>
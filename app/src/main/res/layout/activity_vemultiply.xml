<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/SV_VEMult"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            tools:context=".activities.VEMultiply">

        <TextView
                android:id="@+id/textView28mult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center|center_horizontal|center_vertical"
                android:text="Please enter values for vector A"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollView2mult"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <HorizontalScrollView
                android:id="@+id/horizontalScrollView2mult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:foregroundGravity="center_vertical|center_horizontal"
                app:layout_constraintBottom_toTopOf="@+id/textView33mult"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView28mult"
                tools:ignore="SpeakableTextPresentCheck">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etAimult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:digits="0123*/456789.-"
                        android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center"
                        android:hint="i"
                        android:inputType="numberSigned|numberDecimal"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="i  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etAjmult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:digits="0123*/456789.-"
                        android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="j"
                        android:inputType="numberSigned|numberDecimal"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="j  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etAkmult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:digits="0123*/456789.-"
                        android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="k"
                        android:inputType="numberSigned|numberDecimal"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="k  "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <TextView
                android:id="@+id/textView33mult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center|center_horizontal|center_vertical"
                android:text="Please enter values for vector B"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/horizontalScrollViewSubmult"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollView2mult"/>

        <HorizontalScrollView
                android:id="@+id/horizontalScrollViewSubmult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="15dp"
                android:foregroundGravity="center_vertical|center_horizontal"
                app:layout_constraintBottom_toTopOf="@+id/btnVEAdd"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView33mult"
                tools:ignore="SpeakableTextPresentCheck">

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etBimult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:digits="0123*/456789.-"
                        android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="i"
                        android:inputType="numberSigned|numberDecimal"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="i  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etBjmult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:digits="0123*/456789.-"
                        android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="j"
                        android:inputType="numberSigned|numberDecimal"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="j  + "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

                <EditText
                        android:singleLine="true"

                        android:id="@+id/etBkmult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="15dp"
                        android:digits="0123*/456789.-"
                        android:ems="4"
                        android:fontFamily="sans-serif"
                        android:gravity="center_horizontal"
                        android:hint="k"
                        android:inputType="numberSigned|numberDecimal"
                        android:minHeight="48dp"
                        android:textColor="@android:color/white"
                        android:textColorHint="@color/text_hint"
                        android:textSize="34sp"
                        tools:ignore="SpeakableTextPresentCheck"/>

                <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="15dp"
                        android:fontFamily="@font/lucidacalligraphy"
                        android:text="k  "
                        android:textColor="@color/text_question"
                        android:textSize="34sp"/>

            </LinearLayout>
        </HorizontalScrollView>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVEAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="Get information"
                android:textColor="@drawable/dynamic_text"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/tvVEAddResults"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/horizontalScrollViewSubmult"/>

        <TextView
                android:id="@+id/tvVEAddResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="50dp"
                android:fontFamily="@font/sans_semi_bold"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="24sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnVEAdd"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
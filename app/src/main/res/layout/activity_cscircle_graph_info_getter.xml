<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".activities.math.CSCircleGraphInfoGetter">

        <TextView
                android:text="Enter the coordinates of the centres of the Circle"
                style="@style/custom_textView"
                android:id="@+id/textView47"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread"
                android:layout_marginTop="30dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/textView57"
                app:layout_constraintVertical_bias="0.0"/>

        <EditText
                android:layout_width="111dp"
                android:layout_height="48dp"
                android:ems="10"
                android:id="@+id/etCSCirH"
                android:gravity="center"
                android:textColor="@color/white_color_on_primary"
                android:fontFamily="sans-serif"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:hint="0"
                android:textColorHint="@color/text_hint"
                android:minHeight="48dp"
                android:inputType="phone"
                app:layout_constraintStart_toEndOf="@+id/textView55"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@+id/textView58"
                app:layout_constraintBottom_toBottomOf="@+id/textView58"
                android:digits="0123456789.+-*/()"
                android:singleLine="true"
        />

        <EditText
                android:layout_width="111dp"
                android:layout_height="48dp"
                android:ems="10"
                android:id="@+id/etCSCirK"
                android:gravity="center"
                android:textColor="@color/white_color_on_primary"
                android:fontFamily="sans-serif"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:hint="0"
                android:textColorHint="@color/text_hint"
                android:minHeight="48dp"
                android:inputType="phone"
                app:layout_constraintStart_toEndOf="@+id/textView58"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@+id/textView57"
                app:layout_constraintBottom_toBottomOf="@+id/textView57"
                android:digits="0123456789.+-*/()"
                android:singleLine="true"
        />

        <EditText
                style="@style/custom_edittext"
                android:id="@+id/etCSCirR"
                android:hint="r"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toBottomOf="@+id/textView50"
                app:layout_constraintBottom_toTopOf="@+id/button21"
        />

        <TextView
                android:text="Enter the radius of the circle"
                style="@style/custom_textView"
                android:id="@+id/textView50"
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView57"
                app:layout_constraintBottom_toTopOf="@+id/etCSCirR"/>

        <TextView
                android:text="h("
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView55"
                android:gravity="center"
                android:textColor="@color/text_question"
                android:fontFamily="@font/sans_bold"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:minHeight="48dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@+id/etCSCirH"
                app:layout_constraintHorizontal_chainStyle="packed"
                android:layout_marginStart="10dp"
                app:layout_constraintBottom_toBottomOf="@+id/etCSCirH"
        />

        <TextView
                android:text=")"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView57"
                android:gravity="center"
                android:textColor="@color/text_question"
                android:fontFamily="@font/sans_bold"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:minHeight="48dp"
                app:layout_constraintStart_toEndOf="@+id/etCSCirK"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView47"
                app:layout_constraintBottom_toTopOf="@+id/textView50"
                android:layout_marginStart="10dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="10dp"/>

        <TextView
                android:text="),   K("
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textView58"
                android:gravity="center"
                android:textColor="@color/text_question"
                android:fontFamily="@font/sans_bold"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:minHeight="48dp"
                app:layout_constraintStart_toEndOf="@+id/etCSCirH"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@+id/etCSCirK"
                app:layout_constraintBottom_toBottomOf="@+id/etCSCirK"
        />

        <androidx.appcompat.widget.AppCompatButton
                style="@style/custom_button_enabled"
                android:text="Get Graph of the circle"
                android:id="@+id/button21"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/etCSCirR"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="30dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
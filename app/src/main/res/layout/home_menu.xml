<?xml version="1.0" encoding="utf-8"?>
<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ui.main.MainActivity">

    <LinearLayout
            style="@style/custom_linearLayout"
            android:id="@+id/homeMenuLinearLayout">

        <com.google.android.material.tabs.TabLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/tabLayout"
                android:background="@color/darker_grey"
                app:tabSelectedTextColor="@color/yellow_num_answer"
                app:tabTextColor="@color/blue_text_answer"
                app:tabIndicatorColor="@color/yellow_num_answer"
                app:tabRippleColor="@color/yellow_num_answer"
                app:fontFamily="@font/sans_bold"
        >

            <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Solver"
                    app:fontFamily="@font/sans_bold"
                    android:id="@+id/SolverTab"/>

            <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tools"
                    app:fontFamily="@font/sans_bold"
                    android:id="@+id/ToolsTab"/>

            <com.google.android.material.tabs.TabItem
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="External \nLinks"
                    app:fontFamily="@font/sans_bold"
                    android:id="@+id/ExtTab"/>

        </com.google.android.material.tabs.TabLayout>

        <androidx.viewpager2.widget.ViewPager2
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/viewPager2"/>

    </LinearLayout>

</ScrollView>
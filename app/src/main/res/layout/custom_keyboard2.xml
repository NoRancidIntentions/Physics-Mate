<?xml version="1.0" encoding="utf-8"?>
<GridLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_sin"
            style="@style/custom_button_enabled_keyboard"
            android:text="sin"
            android:fontFamily="sans-serif-black"
            android:layout_row="0"
            android:layout_column="0"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_cos"
            style="@style/custom_button_enabled_keyboard"
            android:text="cos"
            android:fontFamily="sans-serif-black"
            android:layout_row="0"
            android:layout_column="1"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_tan"
            style="@style/custom_button_enabled_keyboard"
            android:text="tan"
            android:fontFamily="sans-serif-black"
            android:layout_row="0"
            android:layout_column="2"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_arcsin"
            style="@style/custom_button_enabled_keyboard"
            android:text="sin⁻¹"
            android:fontFamily="sans-serif-black"
            android:layout_row="1"
            android:layout_column="0"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_arccos"
            style="@style/custom_button_enabled_keyboard"
            android:text="cos⁻¹"
            android:fontFamily="sans-serif-black"
            android:layout_row="1"
            android:layout_column="1"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_arctan"
            style="@style/custom_button_enabled_keyboard"
            android:text="tan⁻¹"
            android:fontFamily="sans-serif-black"
            android:layout_row="1"
            android:layout_column="2"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_log"
            style="@style/custom_button_enabled_keyboard"
            android:text="ln"
            android:fontFamily="sans-serif-black"
            android:layout_row="2"
            android:layout_column="0"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_pi"
            style="@style/custom_button_enabled_keyboard"
            android:text="π"
            android:fontFamily="sans-serif-black"
            android:layout_row="2"
            android:layout_column="1"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_e"
            style="@style/custom_button_enabled_keyboard"
            android:text="e"
            android:fontFamily="sans-serif-black"
            android:layout_row="2"
            android:layout_column="2"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_switch"
            style="@style/custom_button_enabled_keyboard"
            android:text="switch"
            android:fontFamily="sans-serif-black"
            android:layout_row="3"
            android:layout_column="0"/>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/button_power"
            style="@style/custom_button_enabled_keyboard"
            android:text="^"
            android:fontFamily="sans-serif-black"
            android:layout_row="3"
            android:layout_column="1"/>


</GridLayout>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
            style="@style/custom_linearLayout"
            tools:context=".activities.physics.Kinematics">

        <TextView
                style="@style/custom_textView"
                android:text="Please choose a situation"
                android:layout_marginTop="45dp"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button16"
                style="@style/custom_button_enabled"
                android:text="rectilinear motion"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button14"
                style="@style/custom_button_enabled"
                android:text="projectile motion"
        />

    </LinearLayout>
</ScrollView>
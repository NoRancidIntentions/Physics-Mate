<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/custom_linearLayout"
            android:background="@color/app_bg"
            tools:context=".activities.physics.Gravitation$NLOG">

        <ImageView
                android:id="@+id/imageView"
                android:layout_width="328dp"
                android:layout_height="264dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="40dp"
                android:background="?selectableItemBackgroundBorderless"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toTopOf="@+id/textView29"
                app:layout_constraintDimensionRatio="h,834:637"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/nlogpic"/>

        <TextView
                android:id="@+id/textView29"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="60dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Please select the required formula"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/btnNLOG1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG1"
                style="@style/custom_button_enabled"
                android:text="Calculate Force"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG2"
                style="@style/custom_button_enabled"
                android:text="Calculate m1"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNLOG3"
                style="@style/custom_button_enabled"
                android:text="calculate r"
        />

    </LinearLayout>

</ScrollView>
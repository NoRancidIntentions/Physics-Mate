<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/SV_LOSAC3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/app_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_bg"
            tools:context=".activities.math.LOSAC$LOSAC3">

        <TextView
                android:id="@+id/tvResultsLOSAC"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="50dp"
                android:fontFamily="@font/sans_semi_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="TextView"
                android:textColor="@color/text_question"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/button7cal2"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/editTextNumberDecimal9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="40dp"
                android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal|center_vertical"
                android:inputType="phone"
                android:digits="+-0123*/456789." android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/button7cal2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView20"
                tools:ignore="SpeakableTextPresentCheck"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/editTextNumberDecimal8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="30dp"
                android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal|center_vertical"
                android:inputType="phone"
                android:digits="+-0123*/456789." android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/textView20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView21"
                tools:ignore="SpeakableTextPresentCheck"/>

        <EditText
                android:singleLine="true"

                android:id="@+id/editTextNumberDecimal7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="30dp"
                android:ems="10"
                android:fontFamily="sans-serif"
                android:gravity="center_horizontal|center_vertical"
                android:inputType="phone"
                android:digits="+-0123*/456789." android:minHeight="48dp"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/textView21"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView19"
                tools:ignore="SpeakableTextPresentCheck"/>

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button7cal2"

                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="45dp"
                android:background="@drawable/btn_enabled"
                android:fontFamily="@font/sans_bold"
                android:paddingStart="10dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp"
                android:text="find the remaining values"
                android:textColor="@drawable/dynamic_text"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/tvResultsLOSAC"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextNumberDecimal9"/>

        <TextView
                android:id="@+id/textView20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Enter length of AC"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textColorHint="@color/text_hint"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/editTextNumberDecimal9"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextNumberDecimal8"/>

        <TextView
                android:id="@+id/textView21"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Enter length of BC"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textColorHint="@color/text_hint"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/editTextNumberDecimal8"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/editTextNumberDecimal7"/>

        <TextView
                android:id="@+id/textView19"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/sans_bold"
                android:gravity="center_horizontal|center_vertical"
                android:text="Enter length of AB"
                android:textAllCaps="true"
                android:textColor="@color/text_question"
                android:textColorHint="@color/text_hint"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@+id/editTextNumberDecimal7"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView4"/>

        <ImageView
                android:id="@+id/imageView4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="70dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="60dp"
                app:layout_constraintBottom_toTopOf="@+id/textView19"
                app:layout_constraintDimensionRatio="h,732:356"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/losac"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
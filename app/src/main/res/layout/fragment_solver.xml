<?xml version="1.0" encoding="utf-8"?>

<ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_bg">

    <LinearLayout
            style="@style/mainmenulinearlayout">

        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
                android:layout_marginTop="35dp"/>

        <Button
                android:id="@+id/button12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_light"
                android:fontFamily="@font/sans_bold"
                android:foreground="@drawable/ripple_light"
                android:text="Vector addition and other information"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
        />

        <Button
                android:id="@+id/button13"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_light"
                android:fontFamily="@font/sans_bold"
                android:foreground="@drawable/ripple_light"
                android:text="Vector multiplication and other information"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
        />

        <Button
                android:id="@+id/btnGravitation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_light"
                android:fontFamily="@font/sans_bold"
                android:foreground="@drawable/ripple_light"
                android:text="Gravitation"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button17"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_light"
                android:fontFamily="@font/sans_bold"
                android:foreground="@drawable/ripple_light"
                android:text="kinematics"
                android:textColor="@color/white_color_on_primary"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCollision"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_light"
                android:fontFamily="@font/sans_bold"
                android:foreground="@drawable/ripple_light"
                android:text="Collision"
                android:textColor="@color/white_color_on_primary"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
        />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSpecRelativity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_light"
                android:fontFamily="@font/sans_bold"
                android:foreground="@drawable/ripple_light"
                android:text="Special Relativity"
                android:textColor="@color/white_color_on_primary"
                android:textSize="16sp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>


        <ImageView
                android:layout_width="match_parent"
                android:layout_height="20dp"
                app:srcCompat="@drawable/neon_divider"
        />

    </LinearLayout>

</ScrollView>

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#191919" /> <!-- Darker shade -->
            <corners android:radius="25dp" />
        </shape>
    </item>

    <item android:state_pressed="false">
        <layer-list>
            <!-- Darker Rectangle (Bottom Layer) -->
            <item android:top="0dp" android:left="0dp"
                  android:right="0dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1E1E1E" /> <!-- Darker shade -->
                    <corners android:radius="25dp" />
                </shape>
            </item>
            <!-- Lighter Rectangle (Top Layer) -->
            <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="250dp">
                <shape android:shape="rectangle">
                    <solid android:color="#434343" /> <!-- Lighter shade -->
                    <corners android:topLeftRadius="25dp" android:topRightRadius="25dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
